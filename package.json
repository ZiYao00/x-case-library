{
  "name": "x-case-library",
  "private": true,
  "type": "module",
  "description": "Local X case collection using pinned XActions read-only HTTP primitives.",
  "scripts": {
    "case": "node scripts/run-x-case.mjs",
    "repair": "node scripts/run-x-case.mjs repair",
    "test:workflow": "node --test tests/test-x-case-workflow.mjs",
    "test:links": "node --test tests/test-link-preservation.mjs",
    "test:batch": "node --test tests/test-x-batch-workflow.mjs",
    "test:threads": "node --test tests/test-thread-workflow.mjs",
    "batch": "node scripts/run-x-batch.mjs",
    "collect": "node config/collect-author-case.mjs",
    "finalize": "node scripts/finalize-case.mjs",
    "organize:author": "node scripts/organize-by-author.mjs",
    "migrate:layout-v2": "node scripts/migrate-layout-v2.mjs"
  },
  "dependencies": {
    "xactions": "4.0.1"
  }
}
